export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ status: false, message: 'Method not allowed' });
  }

  try {
    let user_key = '';
    let serial = '';
    let game = 'ProxyPin';

    // รองรับทั้งแบบ Form urlencoded และ JSON
    if (typeof req.body === 'object' && req.body !== null) {
      user_key = req.body.user_key || '';
      serial = req.body.serial || '';
      game = req.body.game || 'ProxyPin';
    } else if (typeof req.body === 'string') {
      const params = new URLSearchParams(req.body);
      user_key = params.get('user_key') || '';
      serial = params.get('serial') || '';
      game = params.get('game') || 'ProxyPin';
    }

    // ยิงต่อจากฝั่ง Server Vercel ไปยัง qqshop.xyz
    const response = await fetch('https://qqshop.xyz/connect', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'
      },
      body: new URLSearchParams({
        game: game,
        user_key: user_key,
        serial: serial
      }).toString()
    });

    const data = await response.json();
    return res.status(200).json(data);
  } catch (error) {
    return res.status(500).json({ status: false, message: 'Server proxy failed' });
  }
}
