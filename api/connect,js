module.exports = async (req, res) => {
  // เปิดรับ CORS และรองรับ Preflight
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  if (req.method !== 'POST') {
    return res.status(405).json({ status: false, message: 'Method Not Allowed' });
  }

  try {
    // ข้ามการตรวจ SSL ชั่วคราว ป้องกันเซิร์ฟเวอร์ปลายทางติดใบรับรอง
    process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';

    let user_key = '';
    let serial = '';
    let game = 'ProxyPin';

    // ดึงค่าคีย์ รองรับทั้งแบบ JSON และ Form
    if (req.body) {
      if (typeof req.body === 'object') {
        user_key = req.body.user_key || '';
        serial = req.body.serial || '';
        game = req.body.game || 'ProxyPin';
      } else if (typeof req.body === 'string') {
        try {
          const parsed = JSON.parse(req.body);
          user_key = parsed.user_key || '';
          serial = parsed.serial || '';
          game = parsed.game || 'ProxyPin';
        } catch (_) {
          const params = new URLSearchParams(req.body);
          user_key = params.get('user_key') || '';
          serial = params.get('serial') || '';
          game = params.get('game') || 'ProxyPin';
        }
      }
    }

    // ส่งต่อไปยัง qqshop.xyz จากฝั่งเซิร์ฟเวอร์
    const formData = new URLSearchParams();
    formData.append('game', game);
    formData.append('user_key', user_key);
    formData.append('serial', serial);

    const response = await fetch('https://qqshop.xyz/connect', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
      },
      body: formData.toString()
    });

    const text = await response.text();

    try {
      const data = JSON.parse(text);
      return res.status(200).json(data);
    } catch (parseErr) {
      return res.status(200).json({ status: false, raw: text });
    }
  } catch (error) {
    return res.status(500).json({ status: false, message: error.message });
  }
};
